meta {
  name: Login - Invalid Credentials (401)
  type: http
  seq: 2
}

post {
  url: {{protocol}}://{{host}}/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "wrong-password"
  }
}

tests {
  test("status 401", function () {
    expect(res.status).to.equal(401);
  });
}

docs {
  Unknown email and wrong password return the same 401, so valid accounts can't be discovered.
}
