meta {
  name: Create User - Alice (Top Secret)
  type: http
  seq: 1
}

post {
  url: {{protocol}}://{{host}}/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "email": "alice-{{runId}}@example.com",
    "password": "{{userPassword}}",
    "first_name": "Alice",
    "last_name": "Analyst",
    "clearance": "TOP SECRET"
  }
}

script:post-response {
  bru.setVar("aliceId", res.body.id);
  bru.setVar("aliceEmail", res.body.email);
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
}

docs {
  Admin only. Users can't register themselves, because that would let anyone pick their own clearance.
}
