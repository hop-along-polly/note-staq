meta {
  name: Update User - Non-admin Raising Own Clearance (403)
  type: http
  seq: 8
}

patch {
  url: {{protocol}}://{{host}}/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bobToken}}
}

body:json {
  {
    "clearance": "TOP SECRET"
  }
}

tests {
  test("status 403", function () {
    expect(res.status).to.equal(403);
  });
}
