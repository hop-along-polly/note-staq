meta {
  name: Reset Password (admin resets Bob)
  type: http
  seq: 4
}

post {
  url: {{protocol}}://{{host}}/reset-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "user_id": "{{bobId}}",
    "new_password": "{{userPassword}}"
  }
}

tests {
  test("status 204", function () {
    expect(res.status).to.equal(204);
  });
}

docs {
  Admins can reset anyone's password with `user_id`. To change your own, send
  `current_password` + `new_password` and omit `user_id`.
}
