meta {
  name: Create User - Bob (Secret)
  type: http
  seq: 2
}

post {
  url: {{protocol}}://{{host}}/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "email": "bob-{{runId}}@example.com",
    "password": "{{userPassword}}",
    "first_name": "Bob",
    "last_name": "Builder",
    "clearance": "SECRET"
  }
}

script:post-response {
  bru.setVar("bobId", res.body.id);
  bru.setVar("bobEmail", res.body.email);
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
}
