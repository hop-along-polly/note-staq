meta {
  name: Share Top Secret Note with Bob (403 - no clearance)
  type: http
  seq: 10
}

put {
  url: {{protocol}}://{{host}}/notes/{{tsNoteId}}/metadata
  body: json
  auth: bearer
}

auth:bearer {
  token: {{aliceToken}}
}

body:json {
  {
    "grant": [
      {
        "email": "{{bobEmail}}",
        "role": "viewer"
      }
    ]
  }
}

tests {
  test("status 403", function () {
    expect(res.status).to.equal(403);
  });
  test("explains clearance", function () {
    expect(res.body.detail).to.contain("does not have clearance");
  });
}

docs {
  Bob holds SECRET, so he can't be granted any role on a TOP SECRET note.
}
