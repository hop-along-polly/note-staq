meta {
  name: Remove Last Owner (409)
  type: http
  seq: 15
}

put {
  url: {{protocol}}://{{host}}/notes/{{tsNoteId}}/metadata
  body: json
  auth: bearer
}

auth:bearer {
  token: {{aliceToken}}
}

body:json {
  {
    "revoke": [
      {
        "email": "{{aliceEmail}}"
      }
    ]
  }
}

tests {
  test("status 409", function () {
    expect(res.status).to.equal(409);
  });
}

docs {
  Alice is the only owner of the Top Secret note, so she can't remove herself.
}
