meta {
  name: Create Note (Alice, Top Secret)
  type: http
  seq: 9
}

post {
  url: {{protocol}}://{{host}}/notes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{aliceToken}}
}

body:json {
  {
    "filename": "eyes-only.md",
    "location": "projects/{{runId}}",
    "classification": "TOP SECRET",
    "content": "Top secret contents."
  }
}

script:post-response {
  bru.setVar("tsNoteId", res.body.id);
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
}
