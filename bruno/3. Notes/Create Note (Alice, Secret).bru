meta {
  name: Create Note (Alice, Secret)
  type: http
  seq: 1
}

post {
  url: {{protocol}}://{{host}}/notes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{aliceToken}}
}

body:json {
  {
    "filename": "mission-brief.md",
    "location": "projects/{{runId}}",
    "classification": "SECRET",
    "content": "# Mission Brief\\n\\nInitial draft."
  }
}

script:post-response {
  bru.setVar("noteId", res.body.id);
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
  test("author is owner", function () {
    expect(res.body.role).to.equal("owner");
  });
}

docs {
  Metadata goes to Postgres and content goes to S3 at `<location>/<filename>`. The author becomes the first owner.
  You can't create a note above your own clearance.
}
